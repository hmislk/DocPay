<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.carecode</groupId>
    <artifactId>DocPay</artifactId>
    <version>1.0</version>
    <packaging>jar</packaging>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <exec.mainClass>org.carecode.docpay.DocPay</exec.mainClass>
        <javafx.version>17.0.8</javafx.version>
        <eclipselink.version>2.7.12</eclipselink.version>
        <mysql.version>8.0.33</mysql.version>
    </properties>

    <dependencies>
        <!-- JavaFX -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- JPA (EclipseLink) -->
        <dependency>
            <groupId>org.eclipse.persistence</groupId>
            <artifactId>eclipselink</artifactId>
            <version>${eclipselink.version}</version>
        </dependency>

        <!-- MySQL Connector/J -->
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <version>${mysql.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- BCrypt -->
        <dependency>
            <groupId>org.mindrot</groupId>
            <artifactId>jbcrypt</artifactId>
            <version>0.4</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- JavaFX Maven Plugin for dev runs -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>${exec.mainClass}</mainClass>
                </configuration>
            </plugin>

            <!-- Shade to build a fat jar if needed -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${exec.mainClass}</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Unpack JavaFX jmods for jlink (needed by jpackage custom runtime) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>unpack-javafx-jmods</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.openjfx</groupId>
                                    <artifactId>javafx-jmods</artifactId>
                                    <version>${javafx.version}</version>
                                    <classifier>win</classifier>
                                    <type>zip</type>
                                    <overWrite>true</overWrite>
                                    <outputDirectory>${project.build.directory}/javafx-jmods</outputDirectory>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Create Windows installer using jpackage -->
            <plugin>
                <groupId>org.panteleyev</groupId>
                <artifactId>jpackage-maven-plugin</artifactId>
                <version>1.9.1</version>
                <configuration>
                    <name>DocPay</name>
                    <appVersion>${project.version}</appVersion>
                    <vendor>Galle Cooperative Hospital</vendor>
                    <destination>${project.build.directory}/installer</destination>
                    <input>${project.build.directory}</input>
                    <mainJar>${project.artifactId}-${project.version}.jar</mainJar>
                    <mainClass>${exec.mainClass}</mainClass>
                    <type>msi</type>
                    <winMenu>true</winMenu>
                    <winShortcut>true</winShortcut>
                    <winDirChooser>true</winDirChooser>
                    <!-- Uncomment and point to an .ico if available -->
                    <!-- <icon>${project.basedir}/src/main/resources/icons/docpay.ico</icon> -->

                    <!-- Build custom runtime image with JavaFX modules -->
                    <runtimeImage>${project.build.directory}/runtime</runtimeImage>
                    <jlinkOptions>
                        <jlinkOption>--strip-debug</jlinkOption>
                        <jlinkOption>--no-header-files</jlinkOption>
                        <jlinkOption>--no-man-pages</jlinkOption>
                        <jlinkOption>--compress=2</jlinkOption>
                        <jlinkOption>--module-path</jlinkOption>
                        <jlinkOption>${project.build.directory}/javafx-jmods;${java.home}/jmods</jlinkOption>
                        <jlinkOption>--add-modules</jlinkOption>
                        <jlinkOption>java.base,java.desktop,java.logging,java.sql,java.xml,javafx.controls,javafx.fxml</jlinkOption>
                    </jlinkOptions>

                    <javaOptions>
                        <!-- Open for JPA reflection if needed -->
                        <javaOption>--add-opens</javaOption>
                        <javaOption>java.base/java.lang=ALL-UNNAMED</javaOption>
                        <javaOption>--add-opens</javaOption>
                        <javaOption>java.base/java.util=ALL-UNNAMED</javaOption>
                    </javaOptions>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
