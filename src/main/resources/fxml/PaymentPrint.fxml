<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.carecode.docpay.controller.PaymentPrintController">
    <top>
        <HBox spacing="8">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <Label text="Payment Receipt" styleClass="title" />
            <Pane HBox.hgrow="ALWAYS" />
            <Button text="Print" onAction="#onPrint" />
            <Button text="New Payment" onAction="#onNewPayment" />
        </HBox>
    </top>
    <center>
        <StackPane fx:id="previewArea">
            <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
        </StackPane>
    </center>
</BorderPane>

