<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.carecode.docpay.controller.PaymentFormController">
    <center>
        <GridPane hgap="10" vgap="10">
            <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
            <columnConstraints>
                <ColumnConstraints percentWidth="30" />
                <ColumnConstraints percentWidth="70" />
            </columnConstraints>
            <children>
                <Label text="Doctor*" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <ComboBox fx:id="cmbDoctor" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                <Label text="Amount*" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                <TextField fx:id="txtAmount" GridPane.rowIndex="1" GridPane.columnIndex="1" promptText="e.g. 2500.00" />

                <Label text="Date" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                <DatePicker fx:id="dpDate" GridPane.rowIndex="2" GridPane.columnIndex="1" />

                <Label text="Description" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                <TextArea fx:id="txtDescription" GridPane.rowIndex="3" GridPane.columnIndex="1" prefRowCount="3" />
            </children>
        </GridPane>
    </center>
    <bottom>
        <HBox spacing="8" alignment="CENTER_RIGHT">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <Label fx:id="lblError" textFill="red" HBox.hgrow="ALWAYS" />
            <Button text="Make Payment" onAction="#onMakePayment" />
        </HBox>
    </bottom>
</BorderPane>

